{
  "expo": {
    "name": "NihongoLearn",
    "slug": "nihongolearn",
    "version": "0.1.0",
    "scheme": "nihongolearn",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.nihongolearn.mobile",
      "blockedPermissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
