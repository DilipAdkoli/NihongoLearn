{
  "name": "nihongolearn",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "preview:web": "node dist/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "export:android": "expo export --platform android",
    "format:check": "prettier --check app src tests public scripts .github/workflows app.json package.json tsconfig.json",
    "export:web": "expo export --platform web && node scripts/prepare-offline-web.mjs"
  },
  "engines": {
    "node": "^24.3.0 || >=26"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo-google-fonts/dm-serif-text": "0.4.1",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.76.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "type": "module"
}
